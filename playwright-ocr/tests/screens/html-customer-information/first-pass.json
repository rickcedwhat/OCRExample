    { "name": "year", "type": "field", "section": null, "boxIds": [23], "charset": "digits" },
    { "name": "odometer", "type": "field", "section": null, "boxIds": [24], "charset": "digits" },
    { "name": "make", "type": "field", "section": null, "boxIds": [25] },
    { "name": "color", "type": "field", "section": null, "boxIds": [26] },
    { "name": "model", "type": "field", "section": null, "boxIds": [27] },
    { "name": "doNotCall", "type": "checkbox", "section": null, "boxIds": [28] }
